rules_version = '2';
// Prompt D Academy v3 — วางใน Firebase Console › Firestore › Rules แล้วกด Publish
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; }

    // เนื้อหาเว็บ: ทุกคนอ่านได้ (จำเป็นสำหรับ SEO / ISR) — แก้ไขได้เฉพาะแอดมิน
    match /courses/{slug} {
      allow read: if resource == null || resource.data.published == true || isAdmin();
      allow write: if isAdmin();
      match /lessons/{id} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    // สถิติผู้ชม (นับแบบไม่ระบุตัวตนจาก lib/track.ts): ทุกคนอ่านได้ / เพิ่มยอดได้เฉพาะช่องที่กำหนด
    // views/lessonViews เพิ่มได้ทีละ 1 และห้ามลด — ต้องเป็นคอร์สที่มีอยู่จริง
    match /stats/{slug} {
      function okKeys() { return request.resource.data.keys().hasOnly(['views', 'lessonViews', 'days', 'lessons']); }
      allow read: if true;
      allow create: if okKeys() && exists(/databases/$(database)/documents/courses/$(slug))
        && request.resource.data.get('views', 0) <= 1 && request.resource.data.get('lessonViews', 0) <= 1;
      allow update: if okKeys()
        && request.resource.data.get('views', 0) >= resource.data.get('views', 0)
        && request.resource.data.get('views', 0) <= resource.data.get('views', 0) + 1
        && request.resource.data.get('lessonViews', 0) >= resource.data.get('lessonViews', 0)
        && request.resource.data.get('lessonViews', 0) <= resource.data.get('lessonViews', 0) + 1;
      allow delete: if isAdmin();
    }
    // คลาสสอนสด: ทุกคนอ่านได้ (เผยแพร่แล้ว) / แอดมินแก้ได้
    // สมาชิกลงทะเบียนได้ครั้งเดียว: สร้าง registrations/{uid} ของตัวเอง + เพิ่ม count ทีละ 1 ใน batch เดียวกัน และต้องไม่เกิน capacity
    match /lives/{slug} {
      function regPath() { return /databases/$(database)/documents/lives/$(slug)/registrations/$(request.auth.uid); }
      allow read: if resource == null || resource.data.published == true || isAdmin();
      allow write: if isAdmin();
      allow update: if signedIn() && resource.data.published == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.get('count', 0) + 1
        && resource.data.get('count', 0) < resource.data.capacity
        && !exists(regPath()) && existsAfter(regPath());
      match /registrations/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
          && getAfter(/databases/$(database)/documents/lives/$(slug)).data.get('count', 0) == get(/databases/$(database)/documents/lives/$(slug)).data.get('count', 0) + 1;
        allow delete: if isAdmin();
      }
    }
    // ลิงก์ห้องเรียน: เห็นได้เฉพาะคนที่ลงทะเบียน และหลังเวลาเปิดห้อง (openAt = 15 นาทีก่อนเริ่ม)
    match /liveSecrets/{slug} {
      allow read: if isAdmin() || (signedIn() && request.time >= resource.data.openAt
        && exists(/databases/$(database)/documents/lives/$(slug)/registrations/$(request.auth.uid)));
      allow write: if isAdmin();
    }
    match /promos/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // ข้อมูลเว็บเดิม (อ่านได้เฉพาะแอดมิน สำหรับนำเข้า)
    match /aiTools/{id} { allow read, write: if isAdmin(); }
    match /learningPaths/{id} { allow read, write: if isAdmin(); }

    // สมาชิก: อ่าน/แก้ของตัวเองได้ แต่ห้ามตั้งสิทธิ์แอดมิน/แพ็กเกจเอง
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.get('isAdmin', false) == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'package', 'packageExpiry', 'suspiciousActivity']));
      allow delete: if isAdmin();
    }

    // คอมเมนต์: อ่านได้ทุกคน, โพสต์ได้เมื่อล็อกอิน, แก้/ลบได้เจ้าของหรือแอดมิน
    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000 && request.resource.data.hidden == false;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
