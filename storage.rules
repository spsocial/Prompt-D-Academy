rules_version = '2';
// วางใน Firebase Console › Storage › Rules
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true; }
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
